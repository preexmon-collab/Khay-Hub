local function smoothShake()
    local basePos = UDim2.new(0.5, -220, 0.5, -140)
    local offsets = {10, -9, 7, -5, 3, 0}
    for _, offset in ipairs(offsets) do
        local tween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {Position = basePos + UDim2.new(0, offset, 0, 0)}
        )
        tween:Play()
        tween.Completed:Wait()
    end
end

local busy = false
VerifyBtn.MouseButton1Click:Connect(function()
    if busy then return end
    if TextBox.Text == correctKey then
        busy = true
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Key Verified! Access Granted."
        saveKey()
        task.wait(0.4)
        ScreenGui:Destroy()
        runMainScript()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
        StatusLabel.Text = "Invalid Key. Please try again."
        TextBox.Text = ""
        smoothShake()
    end
end)

GetKeyBtn.MouseButton1Click:Connect(function()
    if type(setclipboard) == "function" then
        setclipboard(getKeyLink)
        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        StatusLabel.Text = "Discord invite copied! Get the key there."
    else
        StatusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)
        StatusLabel.Text = "Clipboard not supported by this executor."
    end
end)
