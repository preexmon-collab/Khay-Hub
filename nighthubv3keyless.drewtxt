-- [[ S2R Hub - Key System (Black & White Theme, 24H Key Saving) ]]
-- Access key: KhayOnTop
-- The separately hosted main hub is protected. Its visible text is renamed at runtime.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local PlayerGui = Player:FindFirstChild("PlayerGui") or CoreGui

local KEY_FILE = "S2R_Hub_StealAnEggs_Key.json"
local correctKey = "KhayOnTop"
local getKeyLink = "https://discord.gg/VNss3dQgJ3"
local KEY_DURATION = 86400 -- Save valid key for 24 hours
local MAIN_URL = "https://raw.githubusercontent.com/WhiteX1208/Scripts/refs/heads/main/StealAnEggs.luau"
local HUB_NAME = "S2R Hub"

-- Saved keys from the original Night Hub are deliberately ignored.
local function isKeySaved()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false
    end
    local success, data = pcall(function()
        if not isfile(KEY_FILE) then return nil end
        return HttpService:JSONDecode(readfile(KEY_FILE))
    end)
    return success
        and type(data) == "table"
        and data.Key == correctKey
        and type(data.ExpireTime) == "number"
        and os.time() < data.ExpireTime
end

local function saveKey()
    if type(writefile) ~= "function" then return end
    pcall(function()
        writefile(KEY_FILE, HttpService:JSONEncode({
            Key = correctKey,
            ExpireTime = os.time() + KEY_DURATION
        }))
    end)
end

-- Visually rename labels created by the *separately loaded* main hub.
-- It does not change the remote protected source or any of the hub functions.
local renamerStarted = false
local function renameVisibleTitle(value)
    if type(value) ~= "string" then return value end
    -- Case-insensitive spelling variants: Night Hub, NightHub, NIGHT_HUB, etc.
    return (value:gsub("[Nn][Ii][Gg][Hh][Tt][%s_%-]*[Hh][Uu][Bb]", HUB_NAME))
end

local function startVisibleHubRenamer()
    if renamerStarted then return end
    renamerStarted = true

    local tracked = setmetatable({}, {__mode = "k"})
    local watchedRoots = {}

    local function trackText(item)
        if tracked[item] then return end
        if not (item:IsA("TextLabel") or item:IsA("TextButton")) then return end
        tracked[item] = true

        local function fixText()
            local oldText = item.Text
            local newText = renameVisibleTitle(oldText)
            if oldText ~= newText then
                item.Text = newText
            end
        end

        -- Listen to text updates, not just labels that already exist.
        item:GetPropertyChangedSignal("Text"):Connect(fixText)
        fixText()
    end

    local function watchRoot(root)
        if not root or watchedRoots[root] then return end
        watchedRoots[root] = true
        for _, descendant in ipairs(root:GetDescendants()) do
            trackText(descendant)
        end
        root.DescendantAdded:Connect(trackText)
    end

    watchRoot(CoreGui)
    watchRoot(Player:FindFirstChildOfClass("PlayerGui"))

    -- Some supported clients place custom UI under gethui().
    if type(gethui) == "function" then
        local ok, hiddenRoot = pcall(gethui)
        if ok and typeof(hiddenRoot) == "Instance" then
            watchRoot(hiddenRoot)
        end
    end
end

local function runMainScript()
    startVisibleHubRenamer() -- Must start BEFORE main hub creates its interface.
    print("Key verified! Executing S2R Hub script...")
    loadstring(game:HttpGet(MAIN_URL))()
end

if isKeySaved() then
    runMainScript()
    return
end

-- Remove only the previous S2R key GUI so it cannot duplicate itself.
